        "Offset": 0,
        "DescribeType": "permission"
      },
      "table_filter": {
        "field": "Filters",
        "name": "table-name"
      },
      "data_paths": [
        "Response.TableList"
      ]
    },
    "submit": {
      "action": "CreateTask",
      "request": {
        "Task": {
          "SparkSQLTask": {
            "SQL": "",
            "Config": []
          }
        },
        "DatabaseName": "byai_bigdata",
        "DatasourceConnectionName": "DataLakeCatalog",
        "DataEngineName": "prod_monthly_dlc_01",
        "ResourceGroupName": "default_test"
      },
      "sql_field_path": "Task.SparkSQLTask.SQL",
      "sql_encoding": "base64",
      "max_rows_field": null,
      "task_id_paths": [
        "Response.TaskId"
      ]
    },
    "status": {
      "action": "DescribeTaskResult",
      "request": {},
      "task_id_field": "TaskId",
      "status_paths": [
        "Response.TaskInfo.State"
      ]
    },
    "result": {
      "action": "DescribeTaskResult",
      "request": {
        "MaxResults": 1000,
        "IsTransformDataType": true
      },
      "task_id_field": "TaskId",
      "columns_paths": [
        "Response.TaskInfo.ResultSchema"
      ],
      "rows_paths": [
        "Response.TaskInfo.ResultSet"
      ],
      "data_paths": [
        "Response.TaskInfo.ResultSet"
